[submodule ".registry"]
	path = .registry
	url = https://github.com/ices-tools-dev/ices-tools-dev.r-universe.dev
	branch = HEAD
[submodule "FLCore"]
	path = FLCore
	url = https://github.com/flr/FLCore
[submodule "FLFishery"]
	path = FLFishery
	url = https://github.com/flr/FLFishery
[submodule "FLasher"]
	path = FLasher
	url = https://github.com/flr/FLasher
[submodule "FLfse"]
	path = FLfse
	url = https://github.com/flr/FLfse
	subdir = FLfse
[submodule "RDBEScore"]
	path = RDBEScore
	url = https://github.com/ices-tools-dev/RDBEScore
[submodule "RDBESvisualise"]
	path = RDBESvisualise
	url = https://github.com/ices-tools-dev/RDBESvisualise
[submodule "ggplotFL"]
	path = ggplotFL
	url = https://github.com/flr/ggplotFL
[submodule "mixfishtools"]
	path = mixfishtools
	url = https://github.com/ices-tools-dev/mixfishtools
[submodule "sfdSAR"]
	path = sfdSAR
	url = https://github.com/ices-tools-dev/sfdSAR
[submodule "spict"]
	path = spict
	url = https://github.com/iagomosqueira/spict
	subdir = spict
[submodule "stockassessment"]
	path = stockassessment
	url = https://github.com/fishfollower/SAM
	subdir = stockassessment
